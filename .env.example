# --- LLM provider ---
# "mock" needs no key and produces deterministic canned completions (default, used by docker-compose).
# "anthropic" calls the real Messages API.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Sidecar ---
GUARDRAILS_EVAL_URL=http://guardrails-eval:8081

# --- Rate limiting (per API key) ---
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=40000

# --- Cache ---
CACHE_TTL_SECONDS=300

# --- Resilience ---
PROVIDER_TIMEOUT_MS=15000
GUARDRAILS_TIMEOUT_MS=2000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_BREAK_SECONDS=30
